# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

LOLESPORTS_API_KEY=your_key_here

# Optional: enables downloading the Oracle's Elixir CSV via the Drive API v3
# (separate quota from the anonymous web-download page) instead of scraping
# the folder page. Get a free key from a Google Cloud project with the
# Drive API enabled — no billing required.
GOOGLE_DRIVE_API_KEY=your_key_here
